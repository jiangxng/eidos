{
  "name": "eidos-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "AI-Native Framework - Everything Explicit",
  "type": "module",
  "scripts": {
    "dev": "vite playground --port 3000 --open --config configs/build-playground.ts --force --host",
    "build": "tsx scripts/build.ts",
    "build:core": "vite build --config configs/build-core.ts",
    "build:playground": "vite build --config configs/build-playground.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "happy-dom": "^20.11.6",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}