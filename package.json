{
  "name": "@eidos/reference",
  "version": "1.3.0-teach-and-grow.1",
  "private": true,
  "type": "module",
  "description": "LLM-first deterministic experience capability runtime",
  "scripts": {
    "typecheck": "tsc -p tsconfig.convergence.json --noEmit",
    "build": "tsc -p tsconfig.convergence.json",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "test:convergence:v0.2.1": "npm run build && node --test tests/compat/convergence-v021-canonical.test.mjs && EIDOS_CONVERGENCE_ADAPTER=tools/convergence-v021-fixture-adapter.mjs node tools/convergence-fixture-harness.mjs",
    "validate:repo": "node tools/validate-repository.mjs",
    "catalog": "node tools/print-capabilities.mjs",
    "demo:check": "node tools/check-demo.mjs",
    "showcase:check": "node --check showcase/i18n.js && node --check showcase/showcase.js",
    "build:release": "node tools/build-release.mjs && node tools/package-release.mjs",
    "serve:release": "node tools/serve-release.mjs",
    "release:check": "npm run typecheck && npm test && npm run validate:repo && npm run showcase:check && npm run build:release"
  },
  "engines": {"node": ">=20"},
  "devDependencies": {"typescript": "^5.8.3"}
}
