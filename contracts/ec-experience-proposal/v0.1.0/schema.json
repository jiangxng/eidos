{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EC -> Eidos Experience Proposal 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "proposalId",
    "producedAt",
    "composition",
    "context"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "producedAt": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "adaptation": {
      "type": "object"
    },
    "rationale": {
      "type": "array"
    }
  }
}
