{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://contracts.eidos.local/action-request/0.1.0/schema.json",
  "title":"Eidos ActionRequest 0.1.0",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","type","command","values","sourceInteractionId","requiresConfirmation"],
  "properties":{
    "contractVersion":{"const":"0.1.0"},
    "type":{"const":"command"},
    "command":{"type":"object","additionalProperties":false,"required":["code","inputVersion"],"properties":{"code":{"type":"string","minLength":1},"inputVersion":{"type":"string","minLength":1}}},
    "values":{"type":"object"},
    "sourceInteractionId":{"type":"string","minLength":1},
    "actionId":{"type":"string","minLength":1},
    "runtimeInstanceId":{"type":"string","minLength":1},
    "requiresConfirmation":{"type":"boolean"}
  }
}
