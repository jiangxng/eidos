{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eidos ExperienceComposition 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "experienceId",
    "regions"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "experienceId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "stability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "stability": {
            "enum": [
              "invariant",
              "shared-stable",
              "personal-stable",
              "adaptive"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "array"
    },
    "metadata": {
      "type": "object"
    }
  }
}
